{
  "name": "spec",
  "version": "0.0.1",
  "private": true,
  "description": "Spec: a free, open-source, offline-first desktop screenwriting app",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "pnpm --filter spec-desktop dev",
    "build": "pnpm -r --if-present typecheck && pnpm --filter spec-desktop build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
